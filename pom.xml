<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.worm</groupId>
    <artifactId>result-spring-boot-starter</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>result-spring-boot-starter</name>
    <description>Spring Boot 统一返回结果 Starter：ResponseBodyAdvice 统一包装 + ControllerAdvice 全局异常处理，一次接入全站接口格式一致</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 为什么：7 个无源码预置构件的 class 为 major 65，构建/运行 JDK 已切到 21，编译目标需与之对齐 —— 干什么：以 release=21 一次性约束源码级别、字节码目标与 JDK API 签名 -->
        <maven.compiler.release>21</maven.compiler.release>
        <spring-boot.version>4.0.6</spring-boot.version>
        <!-- 为什么：Lombok 1.18.30 发布于 JDK 21 之前，在 JDK 21 的 javac 下注解处理器静默失效；1.18.34 起官方支持 JDK 8~21 全基线 —— 干什么：固定 lombok 版本保证 JDK 8 与 JDK 21 下注解处理均生效 -->
        <lombok.version>1.18.34</lombok.version>
        <!-- 为什么：统一返回体携带 @Schema 注解供 Swagger/Knife4j 文档展示，starter 只需注解 API 本身，不应把文档 UI 传递给消费方 —— 干什么：仅依赖 swagger-annotations，不引入 knife4j/springdoc UI -->
        <swagger-annotations.version>2.2.21</swagger-annotations.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 为什么：本项目独立发布，不依赖内部 BOM，直接导入 Spring Boot 官方 BOM 统一管理 spring-webmvc / jackson / starter-test 等版本 —— 干什么：以 import 方式引入 spring-boot-dependencies -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <!-- @Slf4j 生成的 Logger 与 Spring 内部日志均依赖 slf4j-api，版本由 Spring Boot BOM 管理 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- String 类型返回值与 writeJson 需要 JSON 序列化，版本由 Spring Boot BOM 统一管理 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 统一返回体模型注解（@Schema），供 Swagger / Knife4j 文档展示 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>${swagger-annotations.version}</version>
        </dependency>
        <!-- 为什么：BaseResult.writeJson 编译期需要 servlet API、运行期由 Web 容器提供 —— 干什么：provided 引入 jakarta.servlet-api，版本由 spring-boot-dependencies 统一管理 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 为什么：@Resource 所在的注解 API 需显式声明避免消费侧缺依赖 —— 干什么：引入 jakarta.annotation-api，版本由 spring-boot-dependencies 统一管理 -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <!-- 为什么：ConstraintViolationException 等校验异常由消费方的 Hibernate Validator 提供，starter 仅需在编译期引用 API —— 干什么：provided 引入 jakarta.validation-api，版本由 spring-boot-dependencies 统一管理 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

    <!-- 为什么：开源模块刻意无 parent，继承不到构建父的 distributionManagement，裸 mvn deploy 会因缺发布目标失败 —— 干什么：自持一份与 worm-bom 对齐的发布配置（顶层默认 + profile 覆盖） -->
    <distributionManagement>
        <repository>
            <id>nexusReleases</id>
            <name>releases</name>
            <url>http://127.0.0.1:8081/repository/maven-releases/</url>
        </repository>
        <snapshotRepository>
            <id>nexusSnapshots</id>
            <name>snapshots</name>
            <url>http://127.0.0.1:8081/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <profiles>
        <!-- 为什么：IDEA 全局勾选了 settings-local，POM 内未声明时每次构建都报 profile 不存在 —— 干什么：声明同名 profile 承接本地私服地址 -->
        <profile>
            <id>settings-local</id>
            <distributionManagement>
                <repository>
                    <id>nexusReleases</id>
                    <name>releases</name>
                    <url>http://127.0.0.1:8081/repository/maven-releases/</url>
                </repository>
                <snapshotRepository>
                    <id>nexusSnapshots</id>
                    <name>snapshots</name>
                    <url>http://127.0.0.1:8081/repository/maven-snapshots/</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
        <!-- 为什么：切换到公司内网私服时不应改 POM —— 干什么：以 settings-swcares 覆盖发布地址 -->
        <profile>
            <id>settings-swcares</id>
            <distributionManagement>
                <repository>
                    <id>psi</id>
                    <name>releases</name>
                    <url>http://maven.sw/repository/maven-releases/</url>
                </repository>
                <snapshotRepository>
                    <id>psi</id>
                    <name>snapshots</name>
                    <url>http://maven.sw/repository/maven-snapshots/</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>
</project>
